{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Next.js: Debug Full Stack (Port 3001)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3001"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "startDebugging",
        "pattern": "local (http://localhost:\\d+|https://localhost:\\d+)",
        "name": "🌐 Next.js: Debug Client-side (Port 3001)"
      },
      "presentation": {
        "hidden": false,
        "group": "Next.js Debugging",
        "order": 1
      }
    },
    {
      "name": "🚀 Next.js: Debug Full Stack (Port 3000)",
