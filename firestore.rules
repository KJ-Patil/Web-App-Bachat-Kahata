rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write ONLY their own data under users/{uid}.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared family-group directory, keyed by the 6-digit join code.
    // Access is scoped to the group's own members (tracked by their real Firebase
    // UID in `memberUids`) so no user can read or tamper with another family's data.
    match /familyGroups/{code} {
      // Single-doc lookup by known code is allowed (needed to join), but listing
      // the whole collection is NOT — so nobody can enumerate other families.
      allow get: if request.auth != null;
      allow list: if false;

      // Creating a new group requires the creator to list themselves as a member.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;

      // Updates: either you're already a member (editing/leaving), or you're a
      // newcomer joining by code.
      //
      // A newcomer may ONLY append their own UID. Testing "is my uid in the new
      // list" is not enough: it lets any signed-in user rewrite memberUids to
      // just themselves, which both grants access to a stranger's group and
      // evicts every real member. So the join branch requires the resulting list
      // to be exactly the existing one plus this caller.
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids
            || request.resource.data.memberUids
               == resource.data.memberUids.concat([request.auth.uid]));

      // Only current members may delete the group document.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      // Per-group shared expense history: readable/writable only by members of
      // the parent group. This is the bulk of the sensitive financial data.
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/familyGroups/$(code)).data.memberUids;
      }
    }
  }
}
